# Copy to .env, or let `make dev` generate it. `make dev` reads it as a shell
# script too, so quote a value with spaces. docs/install.md explains each.

# The same value as KEERA_AGENTS_SERVICE_KEY on Keera Gateway. Required, at
# least 32 characters: openssl rand -hex 32
KEERA_AGENTS_SERVICE_KEY=

# Seals cookies, agents' gateway keys and connector credentials. Required:
# openssl rand -hex 32
KEERA_AGENTS_SECRET_KEY=

# Keera Gateway as a browser reaches it, and as keera-agents does. The
# container of `--profile full` reaches it at host.containers.internal instead.
KEERA_AGENTS_GATEWAY_URL=http://localhost:8080
#KEERA_AGENTS_GATEWAY_INTERNAL_URL=http://host.containers.internal:8080

# keera-agents as a browser and the chat services reach it. Set it as
# KEERA_AGENTS_URL on the gateway too.
KEERA_AGENTS_PUBLIC_URL=http://localhost:8070

# Where agents run: podman (development) or kubernetes.
#KEERA_AGENTS_DRIVER=podman
#KEERA_AGENTS_IMAGE=localhost/keera-agent:latest

# Interface compose publishes the port on.
KEERA_AGENTS_BIND=127.0.0.1
